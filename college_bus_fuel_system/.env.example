# ==============================================================================
# College Bus Fuel Management System - Environment Configuration
# ==============================================================================

# Application Environment
FLASK_ENV=development
SECRET_KEY=college-fuel-management-secure-secret-key-2026-v1
JWT_SECRET_KEY=jwt-college-fuel-auth-token-super-secure-key-2026
PORT=5000

# Database Configuration (MySQL 8.0)
# The application attempts connection to MySQL. If credentials are empty or MySQL is unavailable,
# it gracefully uses local SQLite (college_bus_fuel.db) without losing data.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=college_bus_fuel_db

# Vice Chancellor (VC) Governance Policy
# If false, VC has read-only executive auditing & analytics view (cannot approve/reject).
# If true, VC can also approve or reject fuel reimbursement requests.
VC_CAN_APPROVE=false

# OCR Configuration
# Path to Tesseract binary on Windows (if installed)
# Standard installation path: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# File Upload Security
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size
UPLOAD_FOLDER=uploads/bills
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,pdf

# Duplicate Detection Thresholds
# Perceptual hash Hamming distance (<= 6 indicates near identical image)
IMAGE_HASH_HAMMING_THRESHOLD=6
